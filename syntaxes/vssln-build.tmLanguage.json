{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "VS Solution build output",
  "scopeName": "source.vssln-build",
  "patterns": [
    {
      "name": "token.error-token",
      "match": "^(?:.+: FAILED|Build FAILED\\.|MSBuild could not start: .*|The build failed to run: .*)$"
    },
    {
      "name": "markup.inserted",
      "match": "^(?:.+: succeeded|Build succeeded\\.)$"
    },
    {
      "name": "token.warn-token",
      "match": "^Build stopped\\.$"
    },
    {
      "name": "token.info-token",
      "match": "^(?:Build|Rebuild|Clean) .+ \\([^)]*\\)$"
    },
    {
      "match": "^(?:.*?)\\s*:\\s*(?:(?!fatal\\s)[A-Za-z][A-Za-z ]*?\\s)?((?:fatal\\s+)?error(?:\\s+[A-Za-z]+\\d+)?)(?=\\s*:)",
      "captures": {
        "1": {
          "name": "token.error-token"
        }
      }
    },
    {
      "match": "^(?:.*?)\\s*:\\s*(?:(?!fatal\\s)[A-Za-z][A-Za-z ]*?\\s)?(warning(?:\\s+[A-Za-z]+\\d+)?)(?=\\s*:)",
      "captures": {
        "1": {
          "name": "token.warn-token"
        }
      }
    }
  ]
}

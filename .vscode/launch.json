{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run extension on fixture workspace",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/test/fixtures/workspace",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run extension on samples/Engine",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/samples/Engine",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    }
  ]
}

{
  "name": "vssln",
  "displayName": "VS Solution",
  "description": "Visual Studio C++ solutions in VS Code: solution panel, build, debug and IntelliSense.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.sln"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vssln",
          "title": "VS Solution",
          "icon": "media/vssln.svg"
        }
      ]
    },
    "views": {
      "vssln": [
        {
          "id": "vssln.status",
          "name": "Status"
        },
        {
          "id": "vssln.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vssln.projects",
        "contents": "No solution found in this workspace.\n[Reload](command:vssln.refresh)\n[Open Folder](command:vscode.openFolder)",
        "when": "vssln.phase == noSolution"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/vssln.json",
        "url": "./schemas/vssln.schema.json"
      }
    ],
    "commands": [
      {
        "command": "vssln.selectSolution",
        "title": "Select solution",
        "category": "VS Solution",
        "icon": "$(edit)"
      },
      {
        "command": "vssln.selectConfiguration",
        "title": "Select configuration",
        "category": "VS Solution",
        "icon": "$(edit)"
      },
      {
        "command": "vssln.selectStartupProject",
        "title": "Select startup project",
        "category": "VS Solution",
        "icon": "$(edit)"
      },
      {
        "command": "vssln.setAsStartup",
        "title": "Set as startup project",
        "category": "VS Solution"
      },
      {
        "command": "vssln.openSettings",
        "title": "Open settings",
        "category": "VS Solution",
        "icon": "$(gear)"
      },
      {
        "command": "vssln.configureToolchain",
        "title": "Configure toolchain",
        "category": "VS Solution"
      },
      {
        "command": "vssln.openProjectFile",
        "title": "Open project file",
        "category": "VS Solution"
      },
      {
        "command": "vssln.revealInExplorer",
        "title": "Reveal in File Explorer",
        "category": "VS Solution"
      },
      {
        "command": "vssln.copyPath",
        "title": "Copy path",
        "category": "VS Solution"
      },
      {
        "command": "vssln.refresh",
        "title": "Reload solution",
        "category": "VS Solution",
        "icon": "$(refresh)"
      },
      {
        "command": "vssln.showLog",
        "title": "Show log",
        "category": "VS Solution",
        "icon": "$(output)"
      },
      {
        "command": "vssln.build",
        "title": "Build solution",
        "icon": "$(tools)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.rebuild",
        "title": "Rebuild solution",
        "icon": "$(debug-restart)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.clean",
        "title": "Clean solution",
        "icon": "$(clear-all)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.stop",
        "title": "Stop build",
        "icon": "$(debug-stop)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.buildProject",
        "title": "Build project",
        "icon": "$(tools)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.rebuildProject",
        "title": "Rebuild project",
        "category": "VS Solution"
      },
      {
        "command": "vssln.cleanProject",
        "title": "Clean project",
        "category": "VS Solution"
      },
      {
        "command": "vssln.showBuildOutput",
        "title": "Show build output",
        "category": "VS Solution"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vssln.build",
          "when": "view == vssln.status && vssln.phase == ready && !vssln.building",
          "group": "navigation@1"
        },
        {
          "command": "vssln.rebuild",
          "when": "view == vssln.status && vssln.phase == ready && !vssln.building",
          "group": "navigation@2"
        },
        {
          "command": "vssln.clean",
          "when": "view == vssln.status && vssln.phase == ready && !vssln.building",
          "group": "navigation@3"
        },
        {
          "command": "vssln.stop",
          "when": "view == vssln.status && vssln.building",
          "group": "navigation@1"
        },
        {
          "command": "vssln.openSettings",
          "when": "view == vssln.status",
          "group": "1_vssln@1"
        },
        {
          "command": "vssln.refresh",
          "when": "view == vssln.status",
          "group": "1_vssln@2"
        },
        {
          "command": "vssln.showLog",
          "when": "view == vssln.status",
          "group": "1_vssln@3"
        }
      ],
      "view/item/context": [
        {
          "command": "vssln.selectSolution",
          "when": "view == vssln.status && viewItem == status.solution",
          "group": "inline"
        },
        {
          "command": "vssln.selectConfiguration",
          "when": "view == vssln.status && viewItem == status.configuration",
          "group": "inline"
        },
        {
          "command": "vssln.selectStartupProject",
          "when": "view == vssln.status && viewItem == status.startup",
          "group": "inline"
        },
        {
          "command": "vssln.setAsStartup",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib)$/",
          "group": "1_startup"
        },
        {
          "command": "vssln.openProjectFile",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib|inactive)$/",
          "group": "2_file@1"
        },
        {
          "command": "vssln.revealInExplorer",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib|inactive)$/",
          "group": "2_file@2"
        },
        {
          "command": "vssln.copyPath",
          "when": "view == vssln.projects && viewItem =~ /^project\\./",
          "group": "2_file@3"
        },
        {
          "command": "vssln.stop",
          "when": "view == vssln.status && viewItem == status.build.running",
          "group": "inline"
        },
        {
          "command": "vssln.buildProject",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib)$/ && !vssln.building",
          "group": "inline"
        },
        {
          "command": "vssln.buildProject",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib)$/ && !vssln.building",
          "group": "0_build@1"
        },
        {
          "command": "vssln.rebuildProject",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib)$/ && !vssln.building",
          "group": "0_build@2"
        },
        {
          "command": "vssln.cleanProject",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib)$/ && !vssln.building",
          "group": "0_build@3"
        }
      ],
      "commandPalette": [
        {
          "command": "vssln.setAsStartup",
          "when": "false"
        },
        {
          "command": "vssln.openProjectFile",
          "when": "false"
        },
        {
          "command": "vssln.revealInExplorer",
          "when": "false"
        },
        {
          "command": "vssln.copyPath",
          "when": "false"
        },
        {
          "command": "vssln.buildProject",
          "when": "false"
        },
        {
          "command": "vssln.rebuildProject",
          "when": "false"
        },
        {
          "command": "vssln.cleanProject",
          "when": "false"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "vssln",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "Build",
              "Rebuild",
              "Clean"
            ],
            "description": "What MSBuild does."
          },
          "project": {
            "type": "string",
            "description": "Project name as in the .sln; the whole solution when omitted."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "vssln-nolocation",
        "owner": "vssln",
        "source": "MSBuild",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(?!.*\\(\\d+(?:,\\d+)*\\)\\s*:)\\s*(?:\\d+(?::\\d+)?>)?(.*?)\\s*:\\s*(?:[A-Za-z][A-Za-z ]*?\\s)?(?:fatal\\s+)?(error|warning)(?:\\s+([A-Za-z]+\\d+))?\\s*:\\s*(.*?)\\s+\\[([^\\]]+)\\]$",
          "kind": "file",
          "file": 5,
          "severity": 2,
          "code": 3,
          "message": 4
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && tsc -p test/integration && tsc -p test/engine && vscode-test",
    "package": "vsce package --no-dependencies --skip-license --allow-missing-repository"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}

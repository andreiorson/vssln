{
  "name": "vssln",
  "displayName": "VS Solution",
  "description": "Visual Studio C++ solutions in VS Code: solution panel, build, debug and IntelliSense.",
  "version": "0.4.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.sln",
    "onDebugResolve:vssln"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vssln",
          "title": "VS Solution",
          "icon": "media/vssln.svg"
        }
      ]
    },
    "views": {
      "vssln": [
        {
          "id": "vssln.status",
          "name": "Status"
        },
        {
          "id": "vssln.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vssln.projects",
        "contents": "No solution found in this workspace.\n[Reload](command:vssln.refresh)\n[Open Folder](command:vscode.openFolder)",
        "when": "vssln.phase == noSolution"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/vssln.json",
        "url": "./schemas/vssln.schema.json"
      }
    ],
    "commands": [
      {
        "command": "vssln.selectSolution",
        "title": "Select solution",
        "category": "VS Solution",
        "icon": "$(edit)"
      },
      {
        "command": "vssln.selectConfiguration",
        "title": "Select configuration",
        "category": "VS Solution",
        "icon": "$(edit)"
      },
      {
        "command": "vssln.selectStartupProject",
        "title": "Select startup project",
        "category": "VS Solution",
        "icon": "$(edit)"
      },
      {
        "command": "vssln.setAsStartup",
        "title": "Set as startup project",
        "category": "VS Solution"
      },
      {
        "command": "vssln.openSettings",
        "title": "Open settings",
        "category": "VS Solution",
        "icon": "$(gear)"
      },
      {
        "command": "vssln.configureToolchain",
        "title": "Configure toolchain",
        "category": "VS Solution"
      },
      {
        "command": "vssln.openProjectFile",
        "title": "Open project file",
        "category": "VS Solution"
      },
      {
        "command": "vssln.revealInExplorer",
        "title": "Reveal in File Explorer",
        "category": "VS Solution"
      },
      {
        "command": "vssln.copyPath",
        "title": "Copy path",
        "category": "VS Solution"
      },
      {
        "command": "vssln.refresh",
        "title": "Reload solution",
        "category": "VS Solution",
        "icon": "$(refresh)"
      },
      {
        "command": "vssln.showLog",
        "title": "Show log",
        "category": "VS Solution",
        "icon": "$(output)"
      },
      {
        "command": "vssln.build",
        "title": "Build solution",
        "icon": "$(tools)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.rebuild",
        "title": "Rebuild solution",
        "icon": "$(sync)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.clean",
        "title": "Clean solution",
        "icon": "$(clear-all)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.stop",
        "title": "Stop build",
        "icon": "$(debug-stop)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.buildProject",
        "title": "Build project",
        "icon": "$(tools)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.rebuildProject",
        "title": "Rebuild project",
        "category": "VS Solution"
      },
      {
        "command": "vssln.cleanProject",
        "title": "Clean project",
        "category": "VS Solution"
      },
      {
        "command": "vssln.showBuildOutput",
        "title": "Show build output",
        "category": "VS Solution"
      },
      {
        "command": "vssln.filterProjects",
        "title": "Filter projects",
        "icon": "$(filter)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.clearProjectsFilter",
        "title": "Clear projects filter",
        "icon": "$(close)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.syncActiveFile",
        "title": "Sync with Active Document",
        "category": "VS Solution",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "vssln.debug",
        "title": "Debug startup project",
        "icon": "$(debug-alt)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.run",
        "title": "Run startup project without debugging",
        "icon": "$(run)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.debugProject",
        "title": "Debug project",
        "icon": "$(debug-alt)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.runProject",
        "title": "Run project without debugging",
        "icon": "$(run)",
        "category": "VS Solution"
      },
      {
        "command": "vssln.startupProject",
        "title": "Startup project name",
        "category": "VS Solution"
      },
      {
        "command": "vssln.configuration",
        "title": "Solution configuration name",
        "category": "VS Solution"
      },
      {
        "command": "vssln.targetPath",
        "title": "Startup project program path",
        "category": "VS Solution"
      },
      {
        "command": "vssln.recomputeIntelliSense",
        "title": "Recompute IntelliSense",
        "category": "VS Solution",
        "icon": "$(refresh)"
      },
      {
        "command": "vssln.recomputeIntelliSenseForProject",
        "title": "Recompute IntelliSense for Project",
        "category": "VS Solution"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vssln.build",
          "when": "view == vssln.status && vssln.phase == ready && !vssln.building",
          "group": "navigation@1"
        },
        {
          "command": "vssln.rebuild",
          "when": "view == vssln.status && vssln.phase == ready && !vssln.building",
          "group": "navigation@2"
        },
        {
          "command": "vssln.clean",
          "when": "view == vssln.status && vssln.phase == ready && !vssln.building",
          "group": "navigation@3"
        },
        {
          "command": "vssln.stop",
          "when": "view == vssln.status && vssln.building",
          "group": "navigation@1"
        },
        {
          "command": "vssln.openSettings",
          "when": "view == vssln.status",
          "group": "1_vssln@1"
        },
        {
          "command": "vssln.refresh",
          "when": "view == vssln.status",
          "group": "1_vssln@2"
        },
        {
          "command": "vssln.showLog",
          "when": "view == vssln.status",
          "group": "1_vssln@3"
        },
        {
          "command": "vssln.filterProjects",
          "when": "view == vssln.projects",
          "group": "navigation@1"
        },
        {
          "command": "vssln.clearProjectsFilter",
          "when": "view == vssln.projects && vssln.filtered",
          "group": "navigation@2"
        },
        {
          "command": "vssln.syncActiveFile",
          "when": "view == vssln.projects && vssln.phase == ready",
          "group": "navigation@3"
        },
        {
          "command": "vssln.debug",
          "when": "view == vssln.status && vssln.phase == ready && !vssln.building && !inDebugMode",
          "group": "navigation@4"
        },
        {
          "command": "vssln.run",
          "when": "view == vssln.status && vssln.phase == ready && !vssln.building && !inDebugMode",
          "group": "navigation@5"
        },
        {
          "command": "vssln.recomputeIntelliSense",
          "when": "view == vssln.status && vssln.phase == ready",
          "group": "1_vssln@0"
        }
      ],
      "view/item/context": [
        {
          "command": "vssln.selectSolution",
          "when": "view == vssln.status && viewItem == status.solution",
          "group": "inline"
        },
        {
          "command": "vssln.selectConfiguration",
          "when": "view == vssln.status && viewItem == status.configuration",
          "group": "inline"
        },
        {
          "command": "vssln.selectStartupProject",
          "when": "view == vssln.status && viewItem == status.startup",
          "group": "inline"
        },
        {
          "command": "vssln.setAsStartup",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib)$/",
          "group": "1_startup"
        },
        {
          "command": "vssln.openProjectFile",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib|inactive)$/",
          "group": "2_file@1"
        },
        {
          "command": "vssln.revealInExplorer",
          "when": "view == vssln.projects && viewItem =~ /^(project\\.(app|lib|inactive)|file)$/",
          "group": "2_file@2"
        },
        {
          "command": "vssln.copyPath",
          "when": "view == vssln.projects && viewItem =~ /^(project\\..*|file|file\\.missing)$/",
          "group": "2_file@3"
        },
        {
          "command": "vssln.stop",
          "when": "view == vssln.status && viewItem == status.build.running",
          "group": "inline"
        },
        {
          "command": "vssln.buildProject",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib)$/ && !vssln.building",
          "group": "inline"
        },
        {
          "command": "vssln.buildProject",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib)$/ && !vssln.building",
          "group": "0_build@1"
        },
        {
          "command": "vssln.rebuildProject",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib)$/ && !vssln.building",
          "group": "0_build@2"
        },
        {
          "command": "vssln.cleanProject",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib)$/ && !vssln.building",
          "group": "0_build@3"
        },
        {
          "command": "vssln.debugProject",
          "when": "view == vssln.projects && viewItem == project.app && !vssln.building",
          "group": "inline"
        },
        {
          "command": "vssln.debugProject",
          "when": "view == vssln.projects && viewItem == project.app && !vssln.building",
          "group": "0_debug@1"
        },
        {
          "command": "vssln.runProject",
          "when": "view == vssln.projects && viewItem == project.app && !vssln.building",
          "group": "0_debug@2"
        },
        {
          "command": "vssln.recomputeIntelliSense",
          "when": "view == vssln.status && viewItem == status.intellisense",
          "group": "inline"
        },
        {
          "command": "vssln.recomputeIntelliSenseForProject",
          "when": "view == vssln.projects && viewItem =~ /^project\\.(app|lib)$/",
          "group": "3_intellisense"
        }
      ],
      "commandPalette": [
        {
          "command": "vssln.setAsStartup",
          "when": "false"
        },
        {
          "command": "vssln.openProjectFile",
          "when": "false"
        },
        {
          "command": "vssln.revealInExplorer",
          "when": "false"
        },
        {
          "command": "vssln.copyPath",
          "when": "false"
        },
        {
          "command": "vssln.buildProject",
          "when": "false"
        },
        {
          "command": "vssln.rebuildProject",
          "when": "false"
        },
        {
          "command": "vssln.cleanProject",
          "when": "false"
        },
        {
          "command": "vssln.clearProjectsFilter",
          "when": "vssln.filtered"
        },
        {
          "command": "vssln.debugProject",
          "when": "false"
        },
        {
          "command": "vssln.runProject",
          "when": "false"
        },
        {
          "command": "vssln.startupProject",
          "when": "false"
        },
        {
          "command": "vssln.configuration",
          "when": "false"
        },
        {
          "command": "vssln.targetPath",
          "when": "false"
        },
        {
          "command": "vssln.syncActiveFile",
          "when": "vssln.phase == ready"
        },
        {
          "command": "vssln.recomputeIntelliSense",
          "when": "vssln.phase == ready"
        },
        {
          "command": "vssln.recomputeIntelliSenseForProject",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vssln.filterProjects",
        "key": "ctrl+alt+f",
        "when": "focusedView == vssln.projects"
      },
      {
        "command": "vssln.build",
        "key": "ctrl+shift+b",
        "when": "vssln.phase == ready"
      },
      {
        "command": "vssln.debug",
        "key": "f5",
        "when": "vssln.phase == ready && !inDebugMode"
      },
      {
        "command": "vssln.run",
        "key": "ctrl+f5",
        "when": "vssln.phase == ready && !inDebugMode"
      }
    ],
    "languages": [
      {
        "id": "vssln-build-output",
        "aliases": [
          "VS Solution build output"
        ]
      }
    ],
    "grammars": [
      {
        "language": "vssln-build-output",
        "scopeName": "source.vssln-build",
        "path": "./syntaxes/vssln-build.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "vssln",
        "label": "VS Solution",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "project": {
                "type": "string",
                "description": "Project name as in the .sln; the startup project when omitted."
              },
              "program": {
                "type": "string",
                "description": "Program to start instead of the project's own."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command line arguments."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables."
              },
              "console": {
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal",
                  "newExternalWindow"
                ],
                "description": "Where the program's console goes."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "vssln",
            "request": "launch",
            "name": "Debug startup project"
          }
        ],
        "configurationSnippets": [
          {
            "label": "VS Solution: Debug a project",
            "description": "Build a project of the solution and debug it with its MSBuild launch settings.",
            "body": {
              "type": "vssln",
              "request": "launch",
              "name": "Debug ${1:Project}",
              "project": "${1:Project}"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && tsc -p test/integration && tsc -p test/engine && vscode-test",
    "package": "vsce package --no-dependencies --skip-license --allow-missing-repository"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "extensionDependencies": [
    "ms-vscode.cpptools"
  ]
}
